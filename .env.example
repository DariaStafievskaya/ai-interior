# Telegram bot token from @BotFather.
BOT_TOKEN=your_telegram_bot_token

# OpenAI API key used for image editing/generation.
OPENAI_API_KEY=your_openai_api_key

# OpenAI image model used by src/services/image-generation/openai.ts.
# Default in code: gpt-image-1
OPENAI_IMAGE_MODEL=gpt-image-1

# Generated image size requested from OpenAI.
# Default in code: 1024x1024
OPENAI_IMAGE_SIZE=1024x1024
